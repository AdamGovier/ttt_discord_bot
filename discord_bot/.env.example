DISCORD_TOKEN=replace-with-your-bot-token
# Optional when the bot belongs to exactly one Discord server:
# DISCORD_GUILD_ID=
BOT_HOST=127.0.0.1
BOT_PORT=37405
# Required for Docker Compose, Dokploy, or any non-loopback listener.
# Match discordbot_api_key in GMod. Generate with: openssl rand -hex 32
BOT_API_KEY=replace-with-a-long-random-key
# Compose: host interface to publish on. Use a private VPN IP for a remote game server.
# BOT_BIND_ADDRESS=127.0.0.1
